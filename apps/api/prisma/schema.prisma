generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Global catalog (no tenant_id; listed in GLOBAL_TABLES for RLS tests) ---

model Module {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospitalSubscriptions HospitalModuleSubscription[]
  branchModules         BranchModule[]

  @@map("modules")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

enum AuthActionPurpose {
  ACTIVATION
  PASSWORD_RESET

  @@map("auth_action_purpose")
}

model HqUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  displayName        String    @map("display_name")
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions     HqAuthSession[]
  actionTokens HqAuthActionToken[]

  @@map("hq_users")
}

/// HQ password-reset action tokens (global). Store token_hash only.
model HqAuthActionToken {
  id        String            @id @default(cuid())
  hqUserId  String            @map("hq_user_id")
  purpose   AuthActionPurpose
  tokenHash String            @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user HqUser @relation(fields: [hqUserId], references: [id], onDelete: Cascade)

  @@index([hqUserId, purpose])
  @@index([id])
  @@map("hq_auth_action_tokens")
}

/// HQ refresh sessions (global — no tenant_id). Store token_hash only.
model HqAuthSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  ip           String?
  userAgent    String?   @map("user_agent")

  user       HqUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy HqAuthSession? @relation("HqSessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   HqAuthSession[] @relation("HqSessionReplacement")

  @@index([tokenHash])
  @@index([familyId])
  @@index([userId])
  @@map("hq_auth_sessions")
}

// --- Patient platform identity (global; hospigo_patient role only; no tenant RLS) ---

enum PatientAccountStatus {
  ACTIVE
  DISABLED

  @@map("patient_account_status")
}

enum PatientOtpPurpose {
  LOGIN
  BOOKING

  @@map("patient_otp_purpose")
}

enum PatientOtpChannel {
  WHATSAPP
  SMS

  @@map("patient_otp_channel")
}

/// Platform-level patient login accounts (phone + OTP). Not linked to hospital patients yet.
model PatientAccount {
  id          String               @id @default(cuid())
  phoneE164   String               @unique @map("phone_e164")
  status      PatientAccountStatus @default(ACTIVE)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt DateTime?            @map("last_login_at") @db.Timestamptz(3)

  sessions PatientAuthSession[]

  @@map("patient_accounts")
}

/// OTP challenges. Store code_hmac only — never the plaintext code.
model PatientOtpChallenge {
  id                 String            @id @default(cuid())
  phoneE164          String            @map("phone_e164")
  purpose            PatientOtpPurpose
  codeHmac           String            @map("code_hmac")
  channel            PatientOtpChannel
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(3)
  attempts           Int               @default(0)
  consumedAt         DateTime?         @map("consumed_at") @db.Timestamptz(3)
  resendAvailableAt  DateTime          @map("resend_available_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, createdAt])
  @@map("patient_otp_challenges")
}

/// Patient refresh sessions (global — mirror hq_auth_sessions).
model PatientAuthSession {
  id           String    @id @default(cuid())
  accountId    String    @map("account_id")
  tokenHash    String    @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  ip           String?
  userAgent    String?   @map("user_agent")

  account    PatientAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  replacedBy PatientAuthSession? @relation("PatientSessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   PatientAuthSession[] @relation("PatientSessionReplacement")

  @@index([tokenHash])
  @@index([familyId])
  @@index([accountId])
  @@map("patient_auth_sessions")
}

/// Global system field catalog (no tenant). Defaults only — hospitals override via patient_field_settings.
model PatientFieldCatalog {
  key            String  @id
  defaultLabel   String  @map("default_label")
  dataType       String  @map("data_type")
  canDisable     Boolean @map("can_disable")
  alwaysRequired Boolean @map("always_required")

  settings PatientFieldSetting[]

  @@map("patient_field_catalog")
}

// --- Tenant tables (all carry tenant_id; hospital.id IS the tenant) ---

enum HospitalStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("hospital_status")
}

model Hospital {
  id         String         @id @default(cuid())
  code       String         @unique
  name       String
  status     HospitalStatus @default(ACTIVE)
  isTest     Boolean        @default(false) @map("is_test")
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings      HospitalSetting[]
  branches      Branch[]
  subscriptions HospitalModuleSubscription[]
  branchModules BranchModule[]
  users         User[]
  userBranches  UserBranch[]
  roles         Role[]
  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]
  roleAssignmentBranches RoleAssignmentBranch[]
  auditLogs     AuditLog[]
  authSessions  AuthSession[]
  actionTokens  AuthActionToken[]
  patients      Patient[]
  patientIdentifiers PatientIdentifier[]
  patientCustomFields PatientCustomField[]
  patientCustomFieldOptions PatientCustomFieldOption[]
  patientCustomFieldValues PatientCustomFieldValue[]
  patientFieldSettings PatientFieldSetting[]
  uhidFormatConfigs UhidFormatConfig[]
  uhidFormatBlocks UhidFormatBlock[]
  uhidCounters UhidCounter[]
  importBatches ImportBatch[]
  importBatchRows ImportBatchRow[]
  importExceptions ImportException[]
  doctorProfiles DoctorProfile[]
  doctorTimings DoctorTiming[]
  doctorLeaves DoctorLeave[]
  chargeItems ChargeItem[]
  chargeItemPrices ChargeItemPrice[]
  doctorFees DoctorFee[]
  medicines Medicine[]
  vitalsFields VitalsField[]
  paymentModes PaymentMode[]
  opdSettings OpdSettings[]
  numberSeriesSettings NumberSeriesSettings[]

  @@map("hospitals")
}

model HospitalSetting {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  key          String
  value        Json
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(3)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, key, effectiveFrom])
  @@index([tenantId, key])
  @@map("hospital_settings")
}

model Branch {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  code       String
  name       String
  accessCode String   @map("access_code")
  isMain     Boolean  @default(false) @map("is_main")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital      Hospital       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchModules BranchModule[]
  userBranches  UserBranch[]
  roleAssignmentBranches RoleAssignmentBranch[]
  auditLogs     AuditLog[]
  authSessions  AuthSession[]
  registeredPatients Patient[]
  importBatches ImportBatch[]
  doctorTimings DoctorTiming[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model HospitalModuleSubscription {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  moduleId  String   @map("module_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  branchModules BranchModule[]

  @@unique([tenantId, id])
  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@map("hospital_module_subscriptions")
}

model BranchModule {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  branchId             String   @map("branch_id")
  moduleId             String   @map("module_id")
  enabledByIndigo      Boolean  @default(true) @map("enabled_by_indigo")
  restrictedByHospital Boolean  @default(false) @map("restricted_by_hospital")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital     Hospital                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch                     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  module       Module                     @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  subscription HospitalModuleSubscription @relation(fields: [tenantId, moduleId], references: [tenantId, moduleId], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, moduleId])
  @@index([tenantId])
  @@map("branch_modules")
}

model User {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  code               String
  email              String
  displayName        String    @map("display_name")
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital        Hospital         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userBranches    UserBranch[]
  roleAssignments RoleAssignment[]
  authSessions    AuthSession[]
  actionTokens    AuthActionToken[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  createdPatients Patient[]        @relation("PatientCreatedBy")
  uhidFormatConfigs UhidFormatConfig[] @relation("UhidConfigCreatedBy")
  patientFieldSettingsChanged PatientFieldSetting[] @relation("FieldSettingChangedBy")
  importBatchesCreated ImportBatch[] @relation("ImportBatchCreatedBy")
  importBatchesApproved ImportBatch[] @relation("ImportBatchApprovedBy")
  importBatchesUndone ImportBatch[] @relation("ImportBatchUndoneBy")
  importExceptionsResolved ImportException[] @relation("ImportExceptionResolvedBy")
  doctorProfiles DoctorProfile[]
  chargeItemPricesCreated ChargeItemPrice[] @relation("ChargeItemPriceCreatedBy")
  doctorFeesCreated DoctorFee[] @relation("DoctorFeeCreatedBy")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Hospital activation / password-reset tokens. Store token_hash only.
model AuthActionToken {
  id        String            @id @default(cuid())
  tenantId  String            @map("tenant_id")
  userId    String            @map("user_id")
  purpose   AuthActionPurpose
  tokenHash String            @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, userId, purpose])
  @@index([id])
  @@map("auth_action_tokens")
}

/// Hospital staff refresh sessions. Store token_hash only; never the raw refresh secret.
model AuthSession {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  userId       String    @map("user_id")
  branchId     String    @map("branch_id")
  tokenHash    String    @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  ip           String?
  userAgent    String?   @map("user_agent")

  hospital   Hospital     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch     Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  replacedBy AuthSession? @relation("AuthSessionReplacement", fields: [tenantId, replacedById], references: [tenantId, id], onDelete: SetNull)
  replaces   AuthSession[] @relation("AuthSessionReplacement")

  @@unique([tenantId, id])
  @@index([tenantId, tokenHash])
  @@index([tenantId, familyId])
  @@index([tenantId, userId])
  @@map("auth_sessions")
}

model UserBranch {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  branchId  String   @map("branch_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch   Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, userId, branchId])
  @@index([tenantId])
  @@map("user_branches")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital        Hospital         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  roleAssignments RoleAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital   Hospital   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

enum RoleScopeType {
  HOSPITAL
  BRANCH

  @@map("role_scope_type")
}

model RoleAssignment {
  id        String        @id @default(cuid())
  tenantId  String        @map("tenant_id")
  userId    String        @map("user_id")
  roleId    String        @map("role_id")
  scopeType RoleScopeType @map("scope_type")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital Hospital               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User                   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role     Role                   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  branches RoleAssignmentBranch[]

  @@unique([tenantId, id])
  @@index([tenantId, userId])
  @@map("role_assignments")
}

model RoleAssignmentBranch {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  assignmentId String   @map("assignment_id")
  branchId     String   @map("branch_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital   Hospital       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment RoleAssignment @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: Cascade)
  branch     Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, assignmentId, branchId])
  @@index([tenantId])
  @@map("role_assignment_branches")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  actorUserId String? @map("actor_user_id")
  branchId   String?  @map("branch_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor    User?    @relation("AuditActor", fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: SetNull)
  branch   Branch?  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// --- Patients (Step 3b-1). Consultant belongs on visits later. ---

model Patient {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  uhid               String
  registeredBranchId String    @map("registered_branch_id")
  name               String
  gender             String?
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  dobIsEstimated     Boolean   @default(false) @map("dob_is_estimated")
  phone              String?
  email              String?
  addressStreet      String?   @map("address_street")
  addressCross       String?   @map("address_cross")
  addressArea        String?   @map("address_area")
  addressCity        String?   @map("address_city")
  addressState       String?   @map("address_state")
  addressPincode     String?   @map("address_pincode")
  isActive           Boolean   @default(true) @map("is_active")
  createdBy          String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital           Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registeredBranch   Branch   @relation(fields: [tenantId, registeredBranchId], references: [tenantId, id], onDelete: Restrict)
  creator            User     @relation("PatientCreatedBy", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: Restrict)
  identifiers        PatientIdentifier[]
  customFieldValues  PatientCustomFieldValue[]

  @@unique([tenantId, id])
  @@unique([tenantId, uhid])
  @@index([tenantId, phone])
  @@index([tenantId])
  @@map("patients")
}

/// Aadhaar and similar identifiers — table exists with RLS; fill/search rules undecided (manager). No app writes yet.
model PatientIdentifier {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  patientId      String   @map("patient_id")
  identifierType String   @map("identifier_type")
  valueEncrypted Bytes    @map("value_encrypted")
  valueHash      String   @map("value_hash")
  last4          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, patientId, identifierType])
  @@index([tenantId, valueHash])
  @@map("patient_identifiers")
}

enum PatientCustomFieldDataType {
  TEXT
  NUMBER
  DATE
  DROPDOWN

  @@map("patient_custom_field_data_type")
}

model PatientCustomField {
  id        String                     @id @default(cuid())
  tenantId  String                     @map("tenant_id")
  code      String
  label     String
  dataType  PatientCustomFieldDataType @map("data_type")
