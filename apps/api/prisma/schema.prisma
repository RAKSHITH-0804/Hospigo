model PatientFieldSetting {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  catalogKey    String?  @map("catalog_key")
  customFieldId String?  @map("custom_field_id")
  isEnabled     Boolean  @map("is_enabled")
  isRequired    Boolean  @map("is_required")
  label         String?
  sortOrder     Int      @default(0) @map("sort_order")
  changedBy     String?  @map("changed_by")
  changedAt     DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital    Hospital             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
