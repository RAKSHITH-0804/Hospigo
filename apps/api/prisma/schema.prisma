  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, series, periodYear])
  @@map("number_series")
}

/// Per-branch OPD queue token counters (one series per IST calendar day).
model TokenCounter {
  tenantId  String   @map("tenant_id")
  branchId  String   @map("branch_id")
  tokenDate DateTime @map("token_date") @db.Date
  lastToken Int      @default(0) @map("last_token")

  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, branchId, tokenDate])
  @@map("token_counters")
}

// ---------------------------------------------------------------------------------------------
// Step 4a: OPD visits and money. The SQL migration is the source of truth for triggers, checks,
// partial unique indexes and grants (Prisma does not model them). Bills, lines, payments and the
// ledger are append-only; the ledger is written only by database triggers.
// ---------------------------------------------------------------------------------------------

enum VisitStatus {
  AWAITING_PAYMENT
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED

  @@map("visit_status")
}

enum BillType {
  CONSULTATION
  INVESTIGATION

  @@map("bill_type")
}

enum PaymentStatus {
  UNPAID
  PART_PAID
  PAID

  @@map("payment_status")
}

enum LedgerEntryType {
  CHARGE
  PAYMENT
  REFUND
  CHARGE_REVERSAL

  @@map("ledger_entry_type")
}

model OpdVisit {
  id                    String      @id @default(cuid())
  tenantId              String      @map("tenant_id")
  branchId              String      @map("branch_id")
  patientId             String      @map("patient_id")
  doctorProfileId       String      @map("doctor_profile_id")
  visitType             VisitType   @map("visit_type")
  visitDate             DateTime    @map("visit_date") @db.Date
  status                VisitStatus @default(AWAITING_PAYMENT)
  previousVisitId       String?     @map("previous_visit_id")
  tokenDate             DateTime?   @map("token_date") @db.Date
  tokenNo               Int?        @map("token_no")
  queuedAt              DateTime?   @map("queued_at") @db.Timestamptz(3)
  consultationStartedAt DateTime?   @map("consultation_started_at") @db.Timestamptz(3)
  completedAt           DateTime?   @map("completed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelledReason       String?     @map("cancelled_reason")
  createdBy             String      @map("created_by")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital      Hospital      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch        Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  patient       Patient       @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  doctor        DoctorProfile @relation(fields: [tenantId, doctorProfileId], references: [tenantId, id], onDelete: Restrict)
  previousVisit OpdVisit?     @relation("OpdVisitPrevious", fields: [tenantId, previousVisitId], references: [tenantId, id], onDelete: Restrict)
  followUps     OpdVisit[]    @relation("OpdVisitPrevious")
  creator       User          @relation("OpdVisitCreatedBy", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: Restrict)
  bills         Bill[]
  consultation  Consultation?
  vitals        VisitVitals[]
  investigationOrders InvestigationOrder[]
  refundRequests RefundRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, branchId])
  @@index([tenantId, branchId, doctorProfileId, status, queuedAt], map: "opd_visits_doctor_queue_idx")
  @@index([tenantId, patientId, doctorProfileId, visitDate(sort: Desc)], map: "opd_visits_followup_idx")
  @@index([tenantId, patientId, createdAt(sort: Desc)], map: "opd_visits_patient_history_idx")
  @@index([tenantId, branchId, visitDate], map: "opd_visits_branch_date_idx")
  @@map("opd_visits")
}

model Bill {
  id             String        @id @default(cuid())
  tenantId       String        @map("tenant_id")
  branchId       String        @map("branch_id")
  visitId        String        @map("visit_id")
  billType       BillType      @map("bill_type")
  billNumber     String        @map("bill_number")
  billDate       DateTime      @default(now()) @map("bill_date") @db.Timestamptz(3)
  subtotalPaise  Int           @map("subtotal_paise")
  taxPaise       Int           @default(0) @map("tax_paise")
  totalPaise     Int           @map("total_paise")
  /// Maintained ONLY by the ledger trigger (the app role cannot update bills).
  paidPaise      Int           @default(0) @map("paid_paise")
  refundedPaise  Int           @default(0) @map("refunded_paise")
  paymentStatus  PaymentStatus @default(UNPAID) @map("payment_status")
  idempotencyKey String        @map("idempotency_key")
  createdBy      String        @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  hospital      Hospital      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  visit         OpdVisit      @relation(fields: [tenantId, visitId, branchId], references: [tenantId, id, branchId], onDelete: Restrict)
  creator       User          @relation("BillCreatedBy", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: Restrict)
  lines         BillLine[]
  payments      Payment[]
  receipts      Receipt[]
  ledgerEntries LedgerEntry[]
  refundRequests RefundRequest[]
  refunds       Refund[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, branchId])
  @@unique([tenantId, billNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, billDate], map: "bills_branch_date_idx")
  @@map("bills")
}

model BillLine {
  id                  String         @id @default(cuid())
  tenantId            String         @map("tenant_id")
  billId              String         @map("bill_id")
  lineNo              Int            @map("line_no")
  kind                ChargeItemKind
  chargeItemId        String?        @map("charge_item_id")
  doctorFeeId         String?        @map("doctor_fee_id")
  codeSnapshot        String         @map("code_snapshot")
  descriptionSnapshot String         @map("description_snapshot")
  quantity            Int            @default(1)
  unitPricePaise      Int            @map("unit_price_paise")
  taxRateBp           Int            @default(0) @map("tax_rate_bp")
  taxPaise            Int            @default(0) @map("tax_paise")
  lineTotalPaise      Int            @map("line_total_paise")
  pricingNote         String?        @map("pricing_note")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  hospital        Hospital                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bill            Bill                    @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Restrict)
  chargeItem      ChargeItem?             @relation(fields: [tenantId, chargeItemId], references: [tenantId, id], onDelete: Restrict)
  doctorFee       DoctorFee?              @relation(fields: [tenantId, doctorFeeId], references: [tenantId, id], onDelete: Restrict)
  registrationFee PatientRegistrationFee?
  investigationOrder InvestigationOrder?

  @@unique([tenantId, id])
  @@unique([tenantId, billId, lineNo], map: "bill_lines_tenant_bill_line_no_key")
  @@map("bill_lines")
}

model Payment {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  billId         String   @map("bill_id")
  branchId       String   @map("branch_id")
  receiptId      String   @map("receipt_id")
  paymentModeId  String   @map("payment_mode_id")
  amountPaise    Int      @map("amount_paise")
  referenceNo    String?  @map("reference_no")
  paidAt         DateTime @default(now()) @map("paid_at") @db.Timestamptz(3)
  receivedBy     String   @map("received_by")
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hospital      Hospital      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bill          Bill          @relation(fields: [tenantId, billId, branchId], references: [tenantId, id, branchId], onDelete: Restrict)
  receipt       Receipt       @relation(fields: [tenantId, receiptId, billId], references: [tenantId, id, billId], onDelete: Restrict)
  paymentMode   PaymentMode   @relation(fields: [tenantId, paymentModeId], references: [tenantId, id], onDelete: Restrict)
  receiver      User          @relation("PaymentReceivedBy", fields: [tenantId, receivedBy], references: [tenantId, id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]
  refunds       Refund[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, billId])
  @@unique([tenantId, receiptId, paymentModeId], map: "payments_receipt_mode_key")
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, billId], map: "payments_bill_idx")
  @@index([tenantId, branchId, paidAt], map: "payments_branch_paid_at_idx")
  @@index([tenantId, receiptId], map: "payments_receipt_idx")
  @@map("payments")
}

/// One receipt covers one or several payments of ONE bill (split payment). Append-only.
/// The database checks at commit that total_paise equals the sum of its payments.
model Receipt {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  branchId       String   @map("branch_id")
  billId         String   @map("bill_id")
  receiptNumber  String   @map("receipt_number")
  totalPaise     Int      @map("total_paise")
  issuedBy       String   @map("issued_by")
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hospital Hospital  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bill     Bill      @relation(fields: [tenantId, billId, branchId], references: [tenantId, id, branchId], onDelete: Restrict)
  issuer   User      @relation("ReceiptIssuedBy", fields: [tenantId, issuedBy], references: [tenantId, id], onDelete: Restrict)
  payments Payment[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, billId])
  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, billId], map: "receipts_bill_idx")
  @@map("receipts")
}

// ---------------------------------------------------------------------------------------------
// Step 5a-2 / 5a-3: consultation note, addenda, vitals, prescription
// ---------------------------------------------------------------------------------------------

enum ConsultationStatus {
  DRAFT
  COMPLETED

  @@map("consultation_status")
}

/// One note per visit. DRAFT until the doctor completes it; a COMPLETED note is frozen by a trigger.
model Consultation {
  id              String             @id @default(cuid())
  tenantId        String             @map("tenant_id")
  branchId        String             @map("branch_id")
  visitId         String             @map("visit_id")
  doctorProfileId String             @map("doctor_profile_id")
  status          ConsultationStatus @default(DRAFT)
  complaints      String?
  diagnosis       String?
  advice          String?
  followUpDate    DateTime?          @map("follow_up_date") @db.Date
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(3)
  /// Copy of the doctor's details, taken by the database when the note is completed.
  doctorDetails   Json?              @map("doctor_details")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital          Hospital               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  visit             OpdVisit               @relation(fields: [tenantId, visitId, branchId], references: [tenantId, id, branchId], onDelete: Restrict)
  doctor            DoctorProfile          @relation(fields: [tenantId, doctorProfileId], references: [tenantId, id], onDelete: Restrict)
  addenda           ConsultationAddendum[]
  prescriptionItems PrescriptionItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, visitId, branchId])
  @@unique([tenantId, visitId])
  @@unique([tenantId, visitId, branchId])
  @@index([tenantId, doctorProfileId, status], map: "consultations_doctor_idx")
  @@map("consultations")
}

/// Append-only correction of a completed note: who, when and why.
model ConsultationAddendum {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  branchId       String   @map("branch_id")
  consultationId String   @map("consultation_id")
  visitId        String   @map("visit_id")
  addendumText   String   @map("addendum_text")
  reason         String
  addedBy        String   @map("added_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hospital     Hospital     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  consultation Consultation @relation(fields: [tenantId, consultationId, visitId, branchId], references: [tenantId, id, visitId, branchId], onDelete: Restrict)
  author       User         @relation("AddendumAddedBy", fields: [tenantId, addedBy], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, consultationId, createdAt], map: "consultation_addenda_consultation_idx")
  @@map("consultation_addenda")
}

/// Append-only, versioned vitals: a correction is a NEW version with a reason; the latest counts.
model VisitVitals {
  id               String           @id @default(cuid())
  tenantId         String           @map("tenant_id")
  branchId         String           @map("branch_id")
  visitId          String           @map("visit_id")
  vitalsFieldId    String           @map("vitals_field_id")
  version          Int
  fieldCode        String           @map("field_code")
  fieldName        String           @map("field_name")
  unit             String
  valueKind        VitalsValueKind  @map("value_kind")
  valueNumber      Decimal?         @map("value_number") @db.Decimal(10, 2)
  valueText        String?          @map("value_text")
  correctionReason String?          @map("correction_reason")
  recordedBy       String           @map("recorded_by")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  hospital   Hospital    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  visit      OpdVisit    @relation(fields: [tenantId, visitId, branchId], references: [tenantId, id, branchId], onDelete: Restrict)
  field      VitalsField @relation(fields: [tenantId, vitalsFieldId], references: [tenantId, id], onDelete: Restrict)
  recorder   User        @relation("VitalsRecordedBy", fields: [tenantId, recordedBy], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, visitId, vitalsFieldId, version], map: "visit_vitals_version_key")
  @@index([tenantId, visitId], map: "visit_vitals_visit_idx")
  @@map("visit_vitals")
}

/// Rows of one DRAFT note (replaced as a whole while drafting; frozen with the note).
model PrescriptionItem {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  branchId       String   @map("branch_id")
  visitId        String   @map("visit_id")
  consultationId String   @map("consultation_id")
  lineNo         Int      @map("line_no")
  medicineId     String?  @map("medicine_id")
  medicineName   String   @map("medicine_name")
  isUnlisted     Boolean  @map("is_unlisted")
  dose           String
  frequency      String
  duration       String
  instructions   String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hospital     Hospital     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  consultation Consultation @relation(fields: [tenantId, consultationId, visitId, branchId], references: [tenantId, id, visitId, branchId], onDelete: Restrict)
  medicine     Medicine?    @relation(fields: [tenantId, medicineId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, consultationId, lineNo], map: "prescription_items_line_key")
  @@index([tenantId, visitId], map: "prescription_items_visit_idx")
  @@map("prescription_items")
}

/// Written ONLY by database triggers (the app role has no INSERT). Append-only.
model LedgerEntry {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  billId      String          @map("bill_id")
  branchId    String          @map("branch_id")
  entryType   LedgerEntryType @map("entry_type")
  amountPaise Int             @map("amount_paise")
  paymentId   String?         @map("payment_id")
  postedAt    DateTime        @default(now()) @map("posted_at") @db.Timestamptz(3)

  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bill     Bill     @relation(fields: [tenantId, billId, branchId], references: [tenantId, id, branchId], onDelete: Restrict)
  payment  Payment? @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, billId], map: "ledger_entries_bill_idx")
  @@index([tenantId, branchId, postedAt], map: "ledger_entries_branch_posted_idx")
  @@map("ledger_entries")
}

model PatientRegistrationFee {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  patientId  String    @map("patient_id")
  billLineId String    @map("bill_line_id")
  chargedAt  DateTime  @default(now()) @map("charged_at") @db.Timestamptz(3)
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)

  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient  Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  billLine BillLine @relation(fields: [tenantId, billLineId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, billLineId])
  @@map("patient_registration_fees")
}

// ---------------------------------------------------------------------------------------------
// Step 6a: tests ordered by the doctor, the investigations bill, refunds
// ---------------------------------------------------------------------------------------------

enum InvestigationOrderStatus {
  ORDERED
  BILLED
  NOT_TAKEN

  @@map("investigation_order_status")
}

enum RefundRequestType {
  REFUND
  CANCEL_VISIT

  @@map("refund_request_type")
}

enum RefundRequestStatus {
  REQUESTED
  APPROVED
  REJECTED

  @@map("refund_request_status")
}

/// A test the doctor ordered for a visit. ORDERED -> BILLED (its bill line) or NOT_TAKEN (reason).
model InvestigationOrder {
  id              String                   @id @default(cuid())
  tenantId        String                   @map("tenant_id")
  branchId        String                   @map("branch_id")
  visitId         String                   @map("visit_id")
  doctorProfileId String                   @map("doctor_profile_id")
  chargeItemId    String                   @map("charge_item_id")
  codeSnapshot    String                   @map("code_snapshot")
  nameSnapshot    String                   @map("name_snapshot")
  status          InvestigationOrderStatus @default(ORDERED)
  billLineId      String?                  @map("bill_line_id")
  notTakenReason  String?                  @map("not_taken_reason")
  orderedBy       String                   @map("ordered_by")
  resolvedBy      String?                  @map("resolved_by")
  resolvedAt      DateTime?                @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  hospital   Hospital      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  visit      OpdVisit      @relation(fields: [tenantId, visitId, branchId], references: [tenantId, id, branchId], onDelete: Restrict)
  doctor     DoctorProfile @relation(fields: [tenantId, doctorProfileId], references: [tenantId, id], onDelete: Restrict)
  chargeItem ChargeItem    @relation(fields: [tenantId, chargeItemId], references: [tenantId, id], onDelete: Restrict)
  billLine   BillLine?     @relation(fields: [tenantId, billLineId], references: [tenantId, id], onDelete: Restrict)
  orderer    User          @relation("InvestigationOrderedBy", fields: [tenantId, orderedBy], references: [tenantId, id], onDelete: Restrict)
  resolver   User?         @relation("InvestigationResolvedBy", fields: [tenantId, resolvedBy], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, visitId, chargeItemId], map: "investigation_orders_visit_test_key")
  @@unique([tenantId, billLineId], map: "investigation_orders_bill_line_key")
  @@index([tenantId, branchId, status, createdAt], map: "investigation_orders_pending_idx")
  @@map("investigation_orders")
}

/// A request to return money (REFUND) or to cancel a waiting visit and return its fee (CANCEL_VISIT).
/// The receptionist asks, an Admin decides; the asker never decides. Decided rows never change.
model RefundRequest {
  id             String              @id @default(cuid())
  tenantId       String              @map("tenant_id")
  branchId       String              @map("branch_id")
  billId         String              @map("bill_id")
  visitId        String              @map("visit_id")
  requestType    RefundRequestType   @map("request_type")
  amountPaise    Int                 @map("amount_paise")
  reason         String
  status         RefundRequestStatus @default(REQUESTED)
  requestedBy    String              @map("requested_by")
  requestedAt    DateTime            @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedBy      String?             @map("decided_by")
  decidedAt      DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionNote   String?             @map("decision_note")
  /// The refund voucher number, only when money is returned.
  refundNumber   String?             @map("refund_number")
  idempotencyKey String              @map("idempotency_key")

  hospital  Hospital @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bill      Bill     @relation(fields: [tenantId, billId, branchId], references: [tenantId, id, branchId], onDelete: Restrict)
  visit     OpdVisit @relation(fields: [tenantId, visitId, branchId], references: [tenantId, id, branchId], onDelete: Restrict)
  requester User     @relation("RefundRequestedBy", fields: [tenantId, requestedBy], references: [tenantId, id], onDelete: Restrict)
  decider   User?    @relation("RefundDecidedBy", fields: [tenantId, decidedBy], references: [tenantId, id], onDelete: Restrict)
  refunds   Refund[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, billId])
  @@unique([tenantId, idempotencyKey], map: "refund_requests_idempotency_key")
  @@unique([tenantId, refundNumber], map: "refund_requests_refund_number_key")
  @@index([tenantId, branchId, status, requestedAt], map: "refund_requests_list_idx")
  @@index([tenantId, billId], map: "refund_requests_bill_idx")
  @@map("refund_requests")
}

/// Money returned for an approved request, one row per original payment, in that payment's mode.
/// Append-only; a row writes its REFUND ledger entry by trigger.
model Refund {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  branchId      String   @map("branch_id")
  billId        String   @map("bill_id")
  requestId     String   @map("request_id")
  paymentId     String   @map("payment_id")
  paymentModeId String   @map("payment_mode_id")
  amountPaise   Int      @map("amount_paise")
  referenceNo   String?  @map("reference_no")
  refundedBy    String   @map("refunded_by")
  refundedAt    DateTime @default(now()) @map("refunded_at") @db.Timestamptz(3)

  hospital    Hospital      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bill        Bill          @relation(fields: [tenantId, billId, branchId], references: [tenantId, id, branchId], onDelete: Restrict)
  request     RefundRequest @relation(fields: [tenantId, requestId, billId], references: [tenantId, id, billId], onDelete: Restrict)
  payment     Payment       @relation(fields: [tenantId, paymentId, billId], references: [tenantId, id, billId], onDelete: Restrict)
  paymentMode PaymentMode   @relation(fields: [tenantId, paymentModeId], references: [tenantId, id], onDelete: Restrict)
  refunder    User          @relation("RefundRecordedBy", fields: [tenantId, refundedBy], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, requestId, paymentId], map: "refunds_request_payment_key")
  @@index([tenantId, billId], map: "refunds_bill_idx")
  @@index([tenantId, paymentId], map: "refunds_payment_idx")
  @@index([tenantId, branchId, refundedAt], map: "refunds_branch_refunded_at_idx")
  @@map("refunds")
}

// ---------------------------------------------------------------------------------------------
// Step 7-3: print templates (paper, margins, layout) per hospital and document type
// ---------------------------------------------------------------------------------------------

enum PrintDocType {
  REGISTRATION_SLIP
  RECEIPT
  PRESCRIPTION

  @@map("print_doc_type")
}

enum PrintPaper {
  A4
  A5
  A6
  LABEL
  CUSTOM

  @@map("print_paper")
}

enum PrintOrientation {
  PORTRAIT
  LANDSCAPE

  @@map("print_orientation")
}

enum PrintMode {
  FULL
  PREPRINTED

  @@map("print_mode")
}

/// One template per hospital (or branch) and document type. A hospital without a row uses the
/// built-in default of the code. The layout is JSON validated in code; the database checks sizes.
/// One row per (tenant, coalesce(branch, ''), doc type): enforced by a unique index on that expression.
model PrintTemplate {
  id             String           @id @default(cuid())
  tenantId       String           @map("tenant_id")
  branchId       String?          @map("branch_id")
  docType        PrintDocType     @map("doc_type")
  enabled        Boolean          @default(true)
  paper          PrintPaper
  widthMm        Decimal?         @map("width_mm") @db.Decimal(6, 1)
  heightMm       Decimal?         @map("height_mm") @db.Decimal(6, 1)
  orientation    PrintOrientation @default(PORTRAIT)
  marginTopMm    Decimal          @default(0) @map("margin_top_mm") @db.Decimal(5, 1)
  marginRightMm  Decimal          @default(0) @map("margin_right_mm") @db.Decimal(5, 1)
  marginBottomMm Decimal          @default(0) @map("margin_bottom_mm") @db.Decimal(5, 1)
  marginLeftMm   Decimal          @default(0) @map("margin_left_mm") @db.Decimal(5, 1)
  mode           PrintMode        @default(FULL)
  preset         String?
  layout         Json             @default("{}")
  createdBy      String           @map("created_by")
  updatedBy      String           @map("updated_by")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch   Branch?  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  creator  User     @relation("PrintTemplateCreatedBy", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: Restrict)
  updater  User     @relation("PrintTemplateUpdatedBy", fields: [tenantId, updatedBy], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("print_templates")
}

/// Step 7d: how the staff code of a user is made (prefix + running number). One row per hospital.
model StaffCodeSettings {
  tenantId   String   @id @map("tenant_id")
  prefix     String   @default("STF")
  minWidth   Int      @default(3) @map("min_width")
  lastNumber BigInt   @default(0) @map("last_number")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  hospital Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("staff_code_settings")
}
