# Server-only: Next route handlers call the API here. Never NEXT_PUBLIC_*.
# Put this in apps/web/.env.local (gitignored).
API_INTERNAL_URL=http://127.0.0.1:3000

# Public app origin. Must equal the URL users type in the browser (Origin checks + all
# absolute redirects). Open the app at exactly this origin in dev — 127.0.0.1 and
# localhost are different cookie jars.
APP_URL=http://127.0.0.1:3001

# Optional web session overrides (see apps/web/src/config/session.ts)
# WEB_COOKIE_ACCESS_NAME=hospigo_access
# WEB_COOKIE_REFRESH_NAME=hospigo_refresh
# WEB_COOKIE_CHANGE_NAME=hospigo_change
# WEB_REFRESH_COOKIE_PATH=/api/auth
# WEB_REFRESH_COOKIE_MAX_AGE_SEC=604800
# WEB_CHANGE_PASSWORD_COOKIE_MAX_AGE_SEC=600
# WEB_AUTH_BODY_LIMIT_BYTES=16384
# Trust x-forwarded-for / x-real-ip only behind our own IIS/nginx (default false).
# Production behind a proxy: set true here AND set API AUTH_TRUSTED_PROXY to the real hop count.
# WEB_TRUST_FORWARDED_HEADERS=false

# Optional patient session overrides (see apps/web/src/config/session.ts)
# WEB_PATIENT_COOKIE_ACCESS_NAME=hospigo_patient_access
# WEB_PATIENT_COOKIE_REFRESH_NAME=hospigo_patient_refresh
# WEB_PATIENT_REFRESH_COOKIE_PATH=/api/patient-auth
# WEB_PATIENT_REFRESH_COOKIE_MAX_AGE_SEC=2592000
# WEB_PATIENT_LOGIN_PATH=/patient/login
# WEB_PATIENT_HOME_PATH=/patient
# WEB_PATIENT_UPSTREAM_TIMEOUT_MS=8000
# WEB_PATIENT_OTP_CODE_LENGTH=6
# WEB_PATIENT_ERROR_INVALID_PHONE=
# WEB_PATIENT_ERROR_INVALID_CODE=
# WEB_PATIENT_ERROR_RATE_LIMITED=
# WEB_PATIENT_ERROR_UNAVAILABLE=
# WEB_PATIENT_CODE_SENT_NOTICE=
# WEB_PATIENT_RESEND_COUNTDOWN_LABEL=
# WEB_PATIENT_SIGNED_OUT_NOTICE=
# WEB_PATIENT_EMPTY_PROFILES_TITLE=
# WEB_PATIENT_EMPTY_PROFILES_DESCRIPTION=
# WEB_PATIENT_WELCOME_TEXT=
# WEB_PATIENT_BRAND_TITLE=
# WEB_PATIENT_BRAND_SUBTITLE=
# WEB_PATIENT_STEP_PHONE_HEADING=
# WEB_PATIENT_STEP_CODE_HEADING=
# WEB_PATIENT_PHONE_LABEL=
# WEB_PATIENT_CODE_LABEL=
# WEB_PATIENT_SEND_CODE_LABEL=
# WEB_PATIENT_SENDING_LABEL=
# WEB_PATIENT_VERIFY_LABEL=
