# Server-only: Next route handlers call the API here. Never NEXT_PUBLIC_*.
# Put this in apps/web/.env.local (gitignored).
API_INTERNAL_URL=http://127.0.0.1:3000

# Public app origin. Must equal the URL users type in the browser (Origin checks + all
# absolute redirects). Open the app at exactly this origin in dev — 127.0.0.1 and
# localhost are different cookie jars.
APP_URL=http://127.0.0.1:3001

# Optional web session overrides (see apps/web/src/config/session.ts)
# WEB_COOKIE_ACCESS_NAME=hospigo_access
# WEB_COOKIE_REFRESH_NAME=hospigo_refresh
# WEB_COOKIE_CHANGE_NAME=hospigo_change
# WEB_REFRESH_COOKIE_PATH=/api/auth
# WEB_REFRESH_COOKIE_MAX_AGE_SEC=604800
# WEB_CHANGE_PASSWORD_COOKIE_MAX_AGE_SEC=600
# WEB_AUTH_BODY_LIMIT_BYTES=16384
# Trust x-forwarded-for / x-real-ip only behind our own IIS/nginx (default false).
# Production behind a proxy: set true here AND set API AUTH_TRUSTED_PROXY to the real hop count.
# WEB_TRUST_FORWARDED_HEADERS=false
