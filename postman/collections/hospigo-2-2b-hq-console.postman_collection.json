                "print-design"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"templateId\":\"x\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "16 HQ Admin lists the Super Admins of north",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hqAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/indigo/hospitals/{{northId}}/super-admins",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "indigo",
                "hospitals",
                "{{northId}}",
                "super-admins"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('a list', () => pm.expect(pm.response.json().items).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "17 HQ Admin sees which designs are active in north",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hqAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/indigo/hospitals/{{northId}}/print",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "indigo",
                "hospitals",
                "{{northId}}",
                "print"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('shape', () => pm.expect(pm.response.json()).to.have.keys(['designs','hasLogo']));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
