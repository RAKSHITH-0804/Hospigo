{
  "info": {
    "name": "Hospigo 8b masters setup",
    "description": "Step 8b (API): price change with history and date rules, and the Excel upload routes (permissions, sample files, refusals). BEFORE RUNNING: (1) npm run prisma:seed -w @hospigo/api (import types), (2) restart the API, (3) environment Hospigo Local with staffPassword and superadminPassword. It adds one test price version to one demo test. The real Excel upload (preview, approve, post, cancel) is proven by the automated API tests and by the click steps in the final report; Postman cannot build an Excel file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "receptionEmail",
      "value": "receptionist1@demo-north.example.test"
    },
    {
      "key": "superEmail",
      "value": "superadmin@demo-north.example.test"
    }
  ],
  "item": [
    {
      "name": "0 Setup",
      "item": [
        {
          "name": "1 Login Receptionist (north)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hospital/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hospital",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"accessCode\": \"demo-north-main\", \"email\": \"{{receptionEmail}}\", \"password\": \"{{staffPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('rRecv', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2 Login SuperAdmin (north)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hospital/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hospital",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"accessCode\": \"demo-north-main\", \"email\": \"{{superEmail}}\", \"password\": \"{{superadminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('rSuper', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "3 Pick a test (INVESTIGATION) from the price list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rSuper}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/prices?kind=INVESTIGATION&pageSize=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "prices"
              ],
              "query": [
                {
                  "key": "kind",
                  "value": "INVESTIGATION"
                },
                {
                  "key": "pageSize",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('a test is listed and today is given', () => { pm.expect(j.items.length).to.be.above(0); pm.expect(j.today).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); });",
                  "pm.collectionVariables.set('itemId', j.items[0].itemId);",
                  "pm.collectionVariables.set('curAmount', j.items[0].currentAmountPaise);",
                  "pm.collectionVariables.set('today', j.today);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 Price change (opd.prices.write)",
      "item": [
        {
          "name": "4 Receptionist cannot list prices (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rRecv}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/prices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "prices"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "5 No token (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/prices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "prices"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "6 Same amount again changes nothing (changed false)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rSuper}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/prices/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "prices",
                "items",
                "{{itemId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"amountPaise\":{{curAmount}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('changed false', () => pm.expect(pm.response.json().changed).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "7 A new amount adds a version (changed true)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rSuper}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/prices/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "prices",
                "items",
                "{{itemId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"amountPaise\":{{newAmount}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newAmount', Number(pm.collectionVariables.get('curAmount')) + 100);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('changed true', () => pm.expect(pm.response.json().changed).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "8 History shows the new version first",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rSuper}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/prices/history?itemId={{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "prices",
                "history"
              ],
              "query": [
                {
                  "key": "itemId",
                  "value": "{{itemId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('newest first', () => pm.expect(pm.response.json().items[0].amountPaise).to.eql(Number(pm.collectionVariables.get('newAmount'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "9 A date in the past is refused (DATE_IN_PAST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rSuper}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/prices/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "prices",
                "items",
                "{{itemId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"amountPaise\":1,\"effectiveFrom\":\"2001-01-01\"}",
              "options": {
                "raw": {
