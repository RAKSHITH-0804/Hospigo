{
  "info": {
    "name": "Hospigo 8b availability",
    "description": "Step 8b part D (API): doctor availability: the switch, weekly times per branch and leave periods. BEFORE RUNNING: (1) npm run prisma:migrate -w @hospigo/api (one new migration: DELETE on doctor_timings and doctor_leave), (2) restart the API, (3) environment Hospigo Local with staffPassword and superadminPassword. It changes the FIRST doctor of the demo north main branch and puts everything back (switch on, no times, no leave).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "receptionEmail",
      "value": "receptionist1@demo-north.example.test"
    },
    {
      "key": "superEmail",
      "value": "superadmin@demo-north.example.test"
    }
  ],
  "item": [
    {
      "name": "0 Setup",
      "item": [
        {
          "name": "1 Login Receptionist (north main)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hospital/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hospital",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"accessCode\": \"demo-north-main\", \"email\": \"{{receptionEmail}}\", \"password\": \"{{staffPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('rRecv', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2 Login SuperAdmin (north)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hospital/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hospital",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"accessCode\": \"demo-north-main\", \"email\": \"{{superEmail}}\", \"password\": \"{{superadminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('rSuper', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "3 Pick the first doctor of the branch",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rRecv}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "doctors"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('there is a doctor', () => pm.expect(j.items.length).to.be.above(0));",
                  "pm.collectionVariables.set('docId', j.items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4 Read the availability (200) and keep the branch and today",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rSuper}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/doctors/{{docId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "doctors",
                "{{docId}}",
                "availability"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('has the shape', () => { pm.expect(j.availabilityOn).to.be.a('boolean'); pm.expect(j.timings).to.be.an('array'); pm.expect(j.leaves).to.be.an('array'); pm.expect(j.today).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); });",
                  "pm.test('SuperAdmin may change it', () => pm.expect(j.canWrite).to.eql(true));",
                  "pm.collectionVariables.set('today', j.today);",
                  "pm.collectionVariables.set('branchId', j.branches[0].id);"
                ]
              }
            }
          ]
        }
      ]
    },
