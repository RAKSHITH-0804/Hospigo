    {
      "name": "4 Leave",
      "item": [
        {
          "name": "19 Add a leave for tomorrow and the day after (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rSuper}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/doctors/{{docId}}/availability/leave",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "doctors",
                "{{docId}}",
                "availability",
                "leave"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"fromDate\":\"{{lFrom}}\",\"toDate\":\"{{lTo}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.collectionVariables.get('today');",
                  "const d = new Date(t + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + 1);",
                  "pm.collectionVariables.set('lFrom', d.toISOString().slice(0, 10));",
                  "d.setUTCDate(d.getUTCDate() + 1);",
                  "pm.collectionVariables.set('lTo', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const l = pm.response.json().leaves.find(x => x.fromDate === pm.collectionVariables.get('lFrom'));",
                  "pm.test('the leave is listed', () => pm.expect(l).to.exist);",
                  "pm.collectionVariables.set('leaveId', l.id);"
                ]
