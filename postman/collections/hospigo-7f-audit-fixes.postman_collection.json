              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('fReqA', pm.response.json().request.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "19 SuperAdmin approves: the WHOLE bill is refunded and the visit is cancelled",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rSuper}}"
              }
