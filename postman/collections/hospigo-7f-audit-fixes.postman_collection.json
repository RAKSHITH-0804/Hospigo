              "mode": "raw",
              "raw": "{\"reason\": \"Postman 7f\", \"idempotencyKey\": \"{{fKeyCA}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('fKeyCA', 'PM7F-fKeyCA-' + Date.now());"
                ]
              }
            },
