    {
      "name": "3 Registration fee after a cancelled first visit",
      "item": [
        {
          "name": "16 Register patient F (full refund case)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rRecv}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{fName}}\",\"ageYears\":40,\"phone\":\"{{fPhone}}\",\"confirmDuplicate\":true}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now() % 1000000000;",
                  "pm.collectionVariables.set('fName', 'Pm7f Fee ' + n);",
                  "pm.collectionVariables.set('fPhone', '9' + String(n).padStart(9, '0'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "pm.collectionVariables.set('fPatient', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "17 First visit: the bill has the registration fee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rRecv}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/visits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "visits"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"patientId\":\"{{fPatient}}\",\"doctorProfileId\":\"{{fDoc}}\",\"visitType\":\"NEW\",\"idempotencyKey\":\"{{fKeyA}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('fKeyA', 'PM7F-fKeyA-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const j = pm.response.json();",
                  "const hasReg = j.bill.lines.some(l => l.kind === 'REGISTRATION');",
                  "pm.test('the bill carries the REGISTRATION fee', () => pm.expect(hasReg).to.eql(true));",
                  "pm.collectionVariables.set('fVisitA', j.id);",
                  "pm.collectionVariables.set('fBillA', j.bill.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "18 Reception asks to cancel it (default amount: everything refundable)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rRecv}}"
              }
            ],
            "url": {
