{
  "info": {
    "name": "Hospigo 7f audit fixes",
    "description": "Step 7f (API): duplicate patient check with date of birth and a real boolean confirmDuplicate; the token is mandatory on a receipt template; the registration fee is charged again only after a cancelled first visit whose bill was refunded in full. BEFORE RUNNING: (1) npm run prisma:migrate -w @hospigo/api (two new migrations), (2) restart the API, (3) environment Hospigo Local with staffPassword and superadminPassword. It makes a few test patients and visits (all cancelled at the end) in demo north; it puts the default receipt back.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "receptionEmail",
      "value": "receptionist1@demo-north.example.test"
    },
    {
      "key": "superEmail",
      "value": "superadmin@demo-north.example.test"
    }
  ],
  "item": [
    {
      "name": "0 Setup",
      "item": [
        {
          "name": "1 Login Receptionist (north main)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hospital/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hospital",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"accessCode\": \"demo-north-main\", \"email\": \"{{receptionEmail}}\", \"password\": \"{{staffPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('rRecv', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2 Login SuperAdmin (north)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hospital/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hospital",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"accessCode\": \"demo-north-main\", \"email\": \"{{superEmail}}\", \"password\": \"{{superadminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('rSuper', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "3 Pick Doctor North 2",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{rRecv}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/opd/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "opd",
                "doctors"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().items.find(x => x.name === 'Doctor North 2');",
                  "pm.test('Doctor North 2 is available', () => { pm.expect(d).to.exist; pm.expect(d.available).to.eql(true); });",
                  "pm.collectionVariables.set('fDoc', d.id);"
                ]
              }
            }
          ]
        }
      ]
