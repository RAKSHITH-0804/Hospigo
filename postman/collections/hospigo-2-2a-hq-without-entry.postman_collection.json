        },
        {
          "name": "11 HQ Admin profile names the role HQ_ADMIN and has no hospital",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hqAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('HQ Admin', () => { const b = pm.response.json(); pm.expect(b.kind).to.eql('HQ'); pm.expect(b.roleCodes).to.eql(['HQ_ADMIN']); pm.expect(b.hospitalName).to.eql(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "12 HQ Staff profile names the role HQ_STAFF",
          "request": {
            "method": "GET",
            "header": [
