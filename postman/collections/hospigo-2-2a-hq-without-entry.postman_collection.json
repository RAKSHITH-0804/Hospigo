                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 The hospital sees no HQ trace",
      "item": [
        {
          "name": "13 The hospital staff list shows no HQ person",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hSuper}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/staff?pageSize=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "staff"
              ],
              "query": [
                {
                  "key": "pageSize",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('no HQ person', () => { const t = pm.response.text(); pm.expect(t).to.not.include('(Indigo)'); pm.expect(t).to.not.include('indigo.invalid'); pm.expect(t).to.not.include('indigo.example.org'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "14 The role list has only roles a hospital owns",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hSuper}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "roles"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('no retired roles', () => { const codes = pm.response.json().items.map(r => r.code); pm.expect(codes).to.not.include('TENANT_ADMIN'); pm.expect(codes).to.not.include('INDIGO_EMPLOYEE'); pm.expect(codes).to.include('SUPER_ADMIN'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "15 The Indigo access log screen is gone (404)",
          "request": {
            "method": "GET",
            "header": [
