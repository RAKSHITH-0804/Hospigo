{
  "info": {
    "name": "Hospigo 2.2a: HQ without entry (HQ never enters a hospital)",
    "description": "Phase 2.2, checkpoint 1. Needs the Hospigo Local environment (baseUrl, staffPassword, superadminPassword, indigoPassword) and the test seed with the HQ demo people (SEED_INDIGO_PASSWORD): hq.admin@indigo.example.org and hq.staff@indigo.example.org. Changes nothing (reads and refusals only).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "superEmail",
      "value": "superadmin@demo-north.example.test"
    },
    {
      "key": "receptionEmail",
      "value": "receptionist1@demo-north.example.test"
    },
    {
      "key": "hqAdminEmail",
      "value": "hq.admin@indigo.example.org"
    },
    {
      "key": "hqStaffEmail",
      "value": "hq.staff@indigo.example.org"
    }
  ],
  "item": [
    {
      "name": "0 Setup",
      "item": [
        {
          "name": "1 Login Super Admin (north main)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hospital/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hospital",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"accessCode\":\"demo-north-main\",\"email\":\"{{superEmail}}\",\"password\":\"{{superadminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('hSuper', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2 Login Receptionist (north main)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hospital/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hospital",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"accessCode\":\"demo-north-main\",\"email\":\"{{receptionEmail}}\",\"password\":\"{{staffPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('hRecv', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "3 Login HQ Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hq/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hq",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{hqAdminEmail}}\",\"password\":\"{{indigoPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('hqAdmin', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "4 Login HQ Staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hq/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hq",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{hqStaffEmail}}\",\"password\":\"{{indigoPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('hqStaff', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 HQ has no door into a hospital",
      "item": [
        {
          "name": "5 The old entry route is gone (HQ Admin gets 404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hqAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/indigo/enter",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "indigo",
                "enter"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hospitalId\":\"any\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
