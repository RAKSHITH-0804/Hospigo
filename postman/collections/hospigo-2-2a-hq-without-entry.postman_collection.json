                  "pm.test('no indigo.access.read', () => pm.expect(pm.response.json().permissions).to.not.include('indigo.access.read'));",
                  "pm.test('Super Admin role code', () => pm.expect(pm.response.json().roleCodes).to.include('SUPER_ADMIN'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 The HQ console (counts and setup only)",
      "item": [
        {
          "name": "17 HQ Admin sees the hospitals (with access codes) and can manage",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hqAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/indigo/hospitals",
              "host": [
                "{{baseUrl}}"
              ],
