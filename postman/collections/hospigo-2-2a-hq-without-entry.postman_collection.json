                "indigo",
                "hospitals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('HQ Admin overview', () => { const b = pm.response.json(); pm.expect(b.canManage).to.eql(true); pm.expect(b.items.length).to.be.above(0); });"
                ]
              }
            }
          ]
        },
