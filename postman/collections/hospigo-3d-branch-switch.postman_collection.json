{
  "info": {
    "name": "Hospigo 3d branch switcher",
    "description": "Step 3d. Uses the superadminPassword and staffPassword variables of the Hospigo Local environment (select that environment). Seed the dev database and start the API on port 3000, then Run collection. About 14 calls count against the login/refresh IP limit (20 per minute): wait a minute between runs. Request 24 ends the SuperAdmin session on purpose (reuse test).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 Setup",
      "item": [
        {
          "name": "1 Login SuperAdmin (north main)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hospital/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hospital",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"accessCode\":\"demo-north-main\",\"email\":\"{{superEmail}}\",\"password\":\"{{superadminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('select the Hospigo Local environment: superadminPassword and staffPassword must be set', () => {",
                  "  pm.expect(pm.variables.get(\"superadminPassword\"), 'superadminPassword').to.be.a('string').and.not.empty;",
                  "  pm.expect(pm.variables.get(\"staffPassword\"), 'staffPassword').to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('login 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('has tokens', () => { pm.expect(j.accessToken).to.be.a('string'); pm.expect(j.refreshToken).to.be.a('string'); });",
                  "pm.collectionVariables.set('superAccess', j.accessToken);",
                  "pm.collectionVariables.set('superRefresh', j.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2 Login Receptionist (north main)",
