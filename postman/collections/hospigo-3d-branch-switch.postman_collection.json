    {
      "name": "1 SuperAdmin switches",
      "item": [
        {
          "name": "6 SuperAdmin /auth/me (before)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superAccess}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('canSwitchBranch is true', () => pm.expect(j.canSwitchBranch).to.eql(true));",
                  "pm.test('is on the main branch', () => pm.expect(j.activeBranchName).to.eql('Main Branch'));",
                  "pm.collectionVariables.set('mainBranchId', j.activeBranchId);"
                ]
              }
            }
          ]
        },
        {
          "name": "7 List switchable branches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superAccess}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/switchable-branches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "switchable-branches"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('two active branches of the own hospital', () => pm.expect(list).to.have.lengthOf(2));",
                  "const east = list.find(b => !b.isMain);",
                  "pm.test('main is current, other is not', () => {",
                  "  pm.expect(list.find(b => b.isMain).isCurrent).to.eql(true);",
                  "  pm.expect(east.isCurrent).to.eql(false);",
                  "});",
                  "pm.test('no other hospital branch listed', () => pm.expect(JSON.stringify(list)).to.not.include(pm.collectionVariables.get('southBranchId')));",
                  "pm.collectionVariables.set('eastBranchId', east.id);",
                  "pm.collectionVariables.set('eastBranchName', east.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "8 SWITCH to the other branch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{superAccess}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/switch-branch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "switch-branch"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"branchId\":\"{{eastBranchId}}\",\"refreshToken\":\"{{superRefresh}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
