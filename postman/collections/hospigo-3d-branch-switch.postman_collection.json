                  "  pm.expect(j.activeBranchName).to.eql(pm.collectionVariables.get('eastBranchName'));",
                  "});",
                  "pm.test('still a switcher', () => pm.expect(j.canSwitchBranch).to.eql(true));",
                  "pm.test('permissions recomputed (array)', () => pm.expect(j.permissions).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
