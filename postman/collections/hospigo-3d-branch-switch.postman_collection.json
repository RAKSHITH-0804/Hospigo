              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('new tokens', () => { pm.expect(j.accessToken).to.be.a('string'); pm.expect(j.refreshToken).to.be.a('string'); pm.expect(j.mustChangePassword).to.eql(false); });",
                  "pm.test('refresh token was rotated', () => pm.expect(j.refreshToken).to.not.eql(pm.collectionVariables.get('superRefresh')));",
                  "pm.collectionVariables.set('superOldRefresh', pm.collectionVariables.get('superRefresh'));",
                  "pm.collectionVariables.set('superAccess', j.accessToken);",
                  "pm.collectionVariables.set('superRefresh', j.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "9 /auth/me shows the NEW branch",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superAccess}}"
              }
