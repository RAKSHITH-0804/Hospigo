            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('switchPatientName', 'Switchtest ' + stamp);",
                  "pm.collectionVariables.set('switchPatientPhone', '9' + String(stamp).slice(-9));"
                ]
              }
            }
