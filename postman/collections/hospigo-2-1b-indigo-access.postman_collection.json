              ],
              "path": [
                "roles"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('no Indigo roles', () => { const codes = pm.response.json().items.map(r => r.code); pm.expect(codes).to.not.include('TENANT_ADMIN'); pm.expect(codes).to.not.include('INDIGO_EMPLOYEE'); });"
                ]
              }
            }
          ]
        },
