{
  "info": {
    "name": "Hospigo 2.1b and 2.1e Indigo access and console",
    "description": "Step 2.1b: the Indigo Owner and Employee enter hospitals through the sign-in without an access code; what the hospital sees; the refusals. Needs the demo Indigo people (SEED_INDIGO_PASSWORD in .env, then the dev seed) and the Hospigo Local environment (staffPassword, superadminPassword, indigoPassword).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "superEmail",
      "value": "superadmin@demo-north.example.test"
    },
    {
      "key": "receptionEmail",
      "value": "receptionist1@demo-north.example.test"
    },
    {
      "key": "indigoOwnerEmail",
      "value": "owner@indigo-demo.example.test"
    },
    {
      "key": "indigoEmployeeEmail",
      "value": "employee@indigo-demo.example.test"
    }
  ],
  "item": [
    {
      "name": "0 Setup",
      "item": [
        {
          "name": "1 Login SuperAdmin (north main)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hospital/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hospital",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"accessCode\":\"demo-north-main\",\"email\":\"{{superEmail}}\",\"password\":\"{{superadminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('xSuper', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2 Login Receptionist (north main)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hospital/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hospital",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"accessCode\":\"demo-north-main\",\"email\":\"{{receptionEmail}}\",\"password\":\"{{staffPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('xRecv', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "3 Login Indigo Owner (no access code)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hq/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hq",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{indigoOwnerEmail}}\",\"password\":\"{{indigoPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('xHqOwner', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "4 Login Indigo Employee (no access code)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/hq/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "hq",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{indigoEmployeeEmail}}\",\"password\":\"{{indigoPassword}}\"}",
              "options": {
