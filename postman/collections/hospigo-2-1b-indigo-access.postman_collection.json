                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('xHqEmp', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 Indigo entry",
      "item": [
        {
          "name": "5 The Owner sees every hospital and picks north and south",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{xHqOwner}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/indigo/hospitals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "indigo",
                "hospitals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items;",
                  "const north = items.find(h => h.code === 'DEMO_NORTH'); const south = items.find(h => h.code === 'DEMO_SOUTH');",
                  "pm.test('both demo hospitals are listed', () => { pm.expect(north).to.exist; pm.expect(south).to.exist; });",
                  "pm.collectionVariables.set('xNorthId', north.id); pm.collectionVariables.set('xSouthId', south.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "6 The Employee sees only the assigned hospital (north)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{xHqEmp}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/indigo/hospitals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "indigo",
                "hospitals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('only north', () => pm.expect(pm.response.json().items.map(h => h.code)).to.eql(['DEMO_NORTH']));"
                ]
              }
            }
          ]
        },
        {
          "name": "7 The Owner enters north",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{xHqOwner}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/indigo/enter",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "indigo",
                "enter"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hospitalId\":\"{{xNorthId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json(); pm.test('a hospital token pair', () => { pm.expect(j.accessToken).to.be.a('string'); pm.expect(j.refreshToken).to.be.a('string'); });",
                  "pm.collectionVariables.set('xOwnerNorth', j.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "8 The Owner is the Indigo Owner inside, hospital-wide",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{xOwnerNorth}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json(); pm.test('Owner role, hospital-wide, named', () => { pm.expect(j.roleCodes).to.eql(['TENANT_ADMIN']); pm.expect(j.hospitalWide).to.eql(true); pm.expect(j.displayName).to.include('(Indigo)'); });",
                  "pm.test('may change templates', () => pm.expect(j.permissions).to.include('print.templates.manage'));"
                ]
              }
            }
          ]
        },
        {
          "name": "9 The Employee enters north: configuration only, no patient data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{xHqEmp}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/indigo/enter",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "indigo",
                "enter"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hospitalId\":\"{{xNorthId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('xEmpNorth', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "10 The Employee has no patient, template or notes permission",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{xEmpNorth}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().permissions; pm.test('configuration yes', () => pm.expect(p).to.include('user.write'));",
                  "pm.test('no patient data, no templates, no notes', () => { ['patients.registry.read','opd.notes.read','opd.visits.read','print.templates.manage','indigo.access.read'].forEach(x => pm.expect(p).to.not.include(x)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "11 The Employee cannot read patients (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{xEmpNorth}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "12 The Employee cannot enter south (same refusal as an unknown hospital)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{xHqEmp}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/indigo/enter",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "indigo",
                "enter"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hospitalId\":\"{{xSouthId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.collectionVariables.set('xRefusal', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "13 An unknown hospital gets the very same answer (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{xHqEmp}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/indigo/enter",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "indigo",
                "enter"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hospitalId\":\"no-such-hospital\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('identical body, nothing to learn', () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('xRefusal')));"
                ]
              }
            }
          ]
        },
        {
          "name": "14 A hospital token cannot enter (it is not an Indigo token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{xSuper}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/indigo/enter",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "indigo",
                "enter"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hospitalId\":\"{{xNorthId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refused', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
                ]
              }
            }
          ]
        },
        {
          "name": "15 No token = 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/indigo/enter",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "indigo",
                "enter"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hospitalId\":\"{{xNorthId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 What the hospital sees",
      "item": [
        {
          "name": "16 The hospital staff list never shows the Indigo people",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{xSuper}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/staff?pageSize=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "staff"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('no hidden Indigo user', () => { const t = pm.response.text(); pm.expect(t).to.not.include('(Indigo)'); pm.expect(t).to.not.include('indigo.invalid'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "17 The role list never shows the Indigo roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{xSuper}}"
              }
            ],
            "url": {
