        {
          "name": "5 The doctor reads their own profile and the original is remembered",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{dDoc}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctor-profiles/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "doctor-profiles",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('a profile with limits and the missing list', () => { pm.expect(j.id).to.be.a('string'); pm.expect(j.printName).to.be.a('string'); pm.expect(j.missing).to.be.an('array'); pm.expect(j.limits.registrationNo).to.eql(40); });",
                  "pm.collectionVariables.set('dId', j.id);",
                  "pm.collectionVariables.set('dDept', j.department === null ? '' : j.department);",
                  "pm.collectionVariables.set('dRestore', JSON.stringify({ printedName: j.printedName, qualifications: j.qualifications, speciality: j.speciality, registrationNo: j.registrationNo }));"
                ]
              }
            }
          ]
        },
