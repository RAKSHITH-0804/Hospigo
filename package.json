{
  "name": "hospigo",
  "version": "0.1.0",
  "private": true,
  "description": "Hospigo monorepo",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx --max-warnings 0 --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:fresh": "node scripts/e2e-fresh.mjs",
    "e2e:stack": "node e2e/test-stack.mjs",
    "dev:reset": "node scripts/dev-reset.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
