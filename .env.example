# Public Hospigo URLs
APP_URL=https://hospigo.indigocomputers.in
API_URL=https://api.hospigo.indigocomputers.in
STAGING_URL=https://staging.hospigo.indigocomputers.in

# API process
NODE_ENV=development
API_PORT=3000

# Postgres connectivity (host/port used by scripts/db/create-roles.mjs)
PGHOST=127.0.0.1
PGPORT=5432

# Superuser URL for one-time role/database bootstrap ONLY (never used by the API at runtime)
POSTGRES_SUPERUSER_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# Role passwords (fill before create-roles; create-roles can also generate them)
HOSPIGO_OWNER_PASSWORD=CHANGE_ME
HOSPIGO_APP_PASSWORD=CHANGE_ME
HOSPIGO_HQ_PASSWORD=CHANGE_ME

# Runtime app user (hospigo_app) — used by Nest PrismaClient via driver adapter
DATABASE_URL=postgresql://hospigo_app:CHANGE_ME@127.0.0.1:5432/hospigo

# Owner user (hospigo_owner) — used by Prisma Migrate / seed (prisma.config.ts)
DATABASE_URL_OWNER=postgresql://hospigo_owner:CHANGE_ME@127.0.0.1:5432/hospigo

# Test database URLs (must use database name hospigo_test)
DATABASE_URL_TEST=postgresql://hospigo_app:CHANGE_ME@127.0.0.1:5432/hospigo_test
DATABASE_URL_OWNER_TEST=postgresql://hospigo_owner:CHANGE_ME@127.0.0.1:5432/hospigo_test
DATABASE_URL_HQ=postgresql://hospigo_hq:CHANGE_ME@127.0.0.1:5432/hospigo

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Local folder storage root (absolute path required at runtime).
# An S3-compatible StorageService driver can replace the local-folder driver later.
STORAGE_ROOT_PATH=

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=hospigo
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@hospigo.indigocomputers.in

# Auth — hospital and HQ access secrets must differ; each >= 32 characters
JWT_HOSPITAL_ACCESS_SECRET=CHANGE_ME_HOSPITAL_ACCESS_SECRET_MIN_32
JWT_HQ_ACCESS_SECRET=CHANGE_ME_HQ_ACCESS_SECRET_MIN_32_CHARS

# Optional auth overrides (defaults match Step 6a approved values)
# AUTH_PASSWORD_MIN_LENGTH=10
# AUTH_TEMP_PASSWORD_LENGTH=14
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_FAILURE_WINDOW_MS=900000
# AUTH_LOGIN_LOCKOUT_MS=900000
# AUTH_IP_RATE_LIMIT_PER_MIN=20
# AUTH_ACCESS_TOKEN_TTL_SEC=900
# AUTH_REFRESH_TOKEN_TTL_SEC=604800
# AUTH_ACTIVATION_LINK_TTL_SEC=172800
# AUTH_RESET_LINK_TTL_SEC=1800

# Patient search (server-enforced max page size)
PATIENT_SEARCH_MAX_PAGE_SIZE=50

# Browser origins allowed to call the API, comma-separated. Unset disables CORS.
CORS_ORIGIN=http://127.0.0.1:3001

# Dev seed passwords (NODE_ENV=development only)
SEED_SUPERADMIN_PASSWORD=CHANGE_ME
SEED_BRANCH_ADMIN_PASSWORD=CHANGE_ME
SEED_STAFF_PASSWORD=CHANGE_ME
