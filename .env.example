# Public Hospigo URLs
APP_URL=https://hospigo.indigocomputers.in
API_URL=https://api.hospigo.indigocomputers.in
STAGING_URL=https://staging.hospigo.indigocomputers.in

# PostgreSQL
DATABASE_URL=postgresql://hospigo:hospigo@localhost:5432/hospigo

# Redis
REDIS_URL=redis://localhost:6379

# MinIO object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hospigo
MINIO_USE_SSL=false

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=hospigo
SMTP_PASSWORD=change-me
SMTP_FROM=noreply@hospigo.indigocomputers.in

# Auth
JWT_SECRET=change-me
